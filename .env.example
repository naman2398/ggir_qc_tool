# Environment Variables Template for GGIR QC Tool
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Azure Active Directory / Microsoft Entra ID Configuration
CLIENT_ID=your-azure-application-client-id
CLIENT_SECRET=your-azure-client-secret
TENANT_ID=your-azure-tenant-id

# SharePoint/OneDrive Configuration
ROOT_FOLDER_PATH=path/to/your/sharepoint/folder
ACCESS_LIST_FILE=App_Access_List.xlsx

# Example values:
# CLIENT_ID=12345678-1234-1234-1234-123456789abc
# CLIENT_SECRET=your_secret_value_here
# TENANT_ID=87654321-4321-4321-4321-cba987654321
# ROOT_FOLDER_PATH=GGIR_Data/Accelerometer_Files
# ACCESS_LIST_FILE=App_Access_List.xlsx
