# GGIR QC Tool - Secrets Configuration
# Copy this file to secrets.toml and fill in your Azure credentials
# NEVER commit secrets.toml to version control

[azure]
client_id = "your-azure-app-client-id"
client_secret = "your-azure-app-client-secret"
tenant_id = "your-azure-tenant-id"

# Application-level settings
# This password is read in src/auth/user_auth.py via:
#   st.secrets.get("app", {}).get("password")
# and is used for logging into the app.
[app]
password = "your-app-password"
